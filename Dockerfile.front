# DXShop 前端镜像（多阶段构建）
#   构建阶段：node 装依赖 + vite build 产出 dist
#   运行阶段：nginx 托管静态文件，并按 vite 的 proxy 规则反代 /api/* 到各后端服务
# 镜像内的 nginx 监听 80；docker-compose 把它映射到宿主机 8080。

# ---------- 1) 构建阶段 ----------
FROM node:22-alpine AS build
WORKDIR /app
# CI 模式：禁用 npm 进度条、tsc 不进入 watch
ENV CI=true
# 先拷依赖清单，利用分层缓存
COPY DXShop-Front/package.json DXShop-Front/package-lock.json ./
RUN npm ci
# 再拷源码并构建（dist 产出到 /app/dist）
COPY DXShop-Front ./
RUN npm run build

# ---------- 2) 运行阶段 ----------
FROM nginx:1.27-alpine
# 移除默认站点配置，使用自定义配置
RUN rm -f /etc/nginx/conf.d/default.conf
# 反代规则：/api/* -> 后端服务名（Docker 内网 DNS），SPA 回退 index.html
COPY deploy/frontend/nginx.conf /etc/nginx/conf.d/default.conf
# 静态产物
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
