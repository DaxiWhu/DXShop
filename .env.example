# DXShop 部署环境变量模板
#
# 用法（在目标 Linux 服务器上）:
#   cp .env.example /opt/dxshop/.env
#   vi /opt/dxshop/.env      # 填入真实值
#
# 注意:
#   - 本文件只是模板，已提交进仓库但只含占位/默认值。
#   - 真实密钥（密码、OSS AK/SK）只在服务器侧的 .env 里填写，绝不提交。
#   - docker-compose.yml 会读取同目录的 .env 来替换 ${...}。

# GHCR 镜像所有者（你的 GitHub 用户名或组织名，决定 ghcr.io/<owner>/dxshop-*）
REGISTRY_OWNER=your-github-owner

# --- 中间件密码 ---
MYSQL_ROOT_PASSWORD=123456
REDIS_PASSWORD=123456
# Nacos 鉴权 token（standalone 模式，建议改成随机串）
NACOS_AUTH_TOKEN=changeMeNacosToken

# --- 阿里云 OSS（敏感！填你自己的真实值；强烈建议先轮换原泄露密钥）---
ALIYUN_OSS_ENDPOINT=oss-cn-wuhan-lr.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=daxi-shop
ALIYUN_OSS_ACCESS_KEY_ID=__FILL_IN__
ALIYUN_OSS_ACCESS_KEY_SECRET=__FILL_IN__
ALIYUN_OSS_ROLE_ARN=__FILL_IN__
