# DXShop-user 服务镜像
# 运行时配置(数据源 / Nacos / Redis / OSS 等)通过环境变量注入,不 bake 进镜像。
# 例: docker run -e SPRING_DATASOURCE_URL=... -e SPRING_DATA_REDIS_HOST=... -p 8082:8082 ghcr.io/<owner>/dxshop-user:latest
FROM eclipse-temurin:25-jre

WORKDIR /app
COPY DXShop-user/target/DXShop-user-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8082
ENTRYPOINT ["java", "-jar", "app.jar"]
